# --- App ---
ENVIRONMENT=development

# --- Backend ---
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Database ---
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POSTGRES_PORT=5432
DATABASE_URL=postgresql://polaris:polaris@localhost:5432/polaris

# --- LLM (OpenAI-compatible; currently Groq) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Seconds before a model call gives up, and how often it is retried
# after a rate limit, server error or dropped connection.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Optional. Model calls each user may make per day (UTC). 0 removes the limit.
# LLM_DAILY_CALLS_PER_USER=100
# Optional. A different model for interview practice only.
# INTERVIEW_MODEL=

# --- GitHub sync (Phase 3) ---
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- LeetCode sync (Phase 3) ---
LEETCODE_USERNAME=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
# Fernet symmetric key for encrypting PATs stored in the database.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output here. Changing this key invalidates all previously
# stored encrypted tokens — users will need to re-link their GitHub accounts.
ENCRYPTION_KEY=

# --- Rate limits (optional) ---
# Requests allowed in each window; 0 removes a limit. Counted in memory, by each
# server process for itself.
# RATE_LIMIT_WINDOW_SECONDS=60
# Every request, per caller address.
# RATE_LIMIT_REQUESTS=120
# Sign-in and sign-up, per caller address. People behind one shared address (a
# campus or office network) share it.
# AUTH_RATE_LIMIT_REQUESTS=10
# Starting AI work, per user.
# AI_RATE_LIMIT_REQUESTS=20
# Needed behind a proxy or load balancer: its IP addresses or networks, comma
# separated, e.g. 10.0.0.0/8. Without it every user appears to be the proxy and
# shares one limit. Only list proxies that add to X-Forwarded-For, because the
# header is believed from them. uvicorn also believes it from the same machine
# (127.0.0.1). Leave uvicorn's FORWARDED_ALLOW_IPS unset; set to "*" it lets
# callers choose their own address.
# TRUSTED_PROXIES=

# --- Observability ---
# Root log level.  Use DEBUG locally to surface raw LLM JSON payloads.
# Valid values: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend (Google Sign-In) ---
VITE_GOOGLE_CLIENT_ID=

# --- Tests (optional) ---
# Database-backed tests run only when this is set. It MUST point at a throwaway
# database whose name contains "test": the test run drops and rebuilds its schema.
# Example: docker run -d -p 55432:5432 -e POSTGRES_USER=test -e POSTGRES_PASSWORD=test #          -e POSTGRES_DB=polaris_test pgvector/pgvector:pg17
# TEST_DATABASE_URL=postgresql://test:test@localhost:55432/polaris_test
