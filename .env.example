# --- App ---
ENVIRONMENT=development

# --- Backend ---
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Database ---
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POSTGRES_PORT=5432
DATABASE_URL=postgresql://polaris:polaris@localhost:5432/polaris

# --- LLM (OpenAI-compatible; currently Groq) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- GitHub sync (Phase 3) ---
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- LeetCode sync (Phase 3) ---
LEETCODE_USERNAME=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
# Fernet symmetric key for encrypting PATs stored in the database.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output here. Changing this key invalidates all previously
# stored encrypted tokens — users will need to re-link their GitHub accounts.
ENCRYPTION_KEY=

# --- Observability ---
# Root log level.  Use DEBUG locally to surface raw LLM JSON payloads.
# Valid values: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend (Google Sign-In) ---
VITE_GOOGLE_CLIENT_ID=

# --- Tests (optional) ---
# Database-backed tests run only when this is set. It MUST point at a throwaway
# database whose name contains "test": the test run drops and rebuilds its schema.
# Example: docker run -d -p 55432:5432 -e POSTGRES_USER=test -e POSTGRES_PASSWORD=test #          -e POSTGRES_DB=polaris_test pgvector/pgvector:pg17
# TEST_DATABASE_URL=postgresql://test:test@localhost:55432/polaris_test
