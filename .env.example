# --- App ---
ENVIRONMENT=development

# --- Backend ---
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Database ---
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POSTGRES_PORT=5432
DATABASE_URL=postgresql://polaris:polaris@localhost:5432/polaris

# --- OLLAMA ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_NUM_CTX=8192

# --- GitHub sync (Phase 3) ---
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- LeetCode sync (Phase 3) ---
LEETCODE_USERNAME=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
# Fernet symmetric key for encrypting PATs stored in the database.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output here. Changing this key invalidates all previously
# stored encrypted tokens — users will need to re-link their GitHub accounts.
ENCRYPTION_KEY=

# --- Observability ---
# Root log level.  Use DEBUG locally to surface raw LLM JSON payloads.
# Valid values: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend (Google Sign-In) ---
VITE_GOOGLE_CLIENT_ID=